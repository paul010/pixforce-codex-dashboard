# No API key or Wi-Fi password is needed. Copy this file to .env for hardware use.
# Set these two IPv4 addresses to match your own network before npm run clock.
PIXFORCE_IP=
PIXFORCE_HOST_IP=
PIXFORCE_HTTP_PORT=8788
PIXFORCE_MQTT_PORT=18884
PIXFORCE_FPS=8
# Optional executable path if codex is not in PATH:
# CODEX_BIN=/path/to/codex
# Optional: read aggregate statistics from a Mac relay instead of a local Codex login.
# Use an absolute path. Leave unset for the original local-account mode.
# PIXFORCE_METRICS_FILE=/absolute/path/to/metrics-snapshot.json
